# Copy to `.env` (gitignored). Values below are placeholders — never commit real secrets.

# PostgreSQL — depends on *where* Node runs (api-server / drizzle migrate):
#
# 1) On your machine (pnpm dev, drizzle-kit migrate from host) → published port from compose:
DATABASE_URL=postgres://user:password@127.0.0.1:5433/aprly
#
# 2) Inside Docker (compose `api-server` service) → compose service name, port 5432:
# DATABASE_URL=postgres://user:password@db:5432/aprly
#
# In docker-compose.yml, `api-server` already overrides DATABASE_URL to (2), so for
# “everything in Docker” your .env can still use (1) — the container API won’t use it for DB.
# For migrations from the host, always use (1) or a one-off `export DATABASE_URL=...`.

PORT=5000
# Optional override for admin plan-lead PDF header logo (default: artifacts/api-server/assets/aprly-logo.png).
# APRLY_PDF_LOGO_PATH=

# Published host port for api-server when using `docker compose` (default 5001 in compose file).
# Prod does not publish this port; safe to change locally only.
API_HOST_PORT=5001
NODE_ENV=development

# Browser origin for CORS + Stripe Checkout return URLs (no trailing slash).
# Local: http://localhost:5173
# Droplet (canonical prod): https://dev.aprly.ai
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_ORIGIN=https://dev.aprly.ai

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_SEC=86400

# SendGrid (transactional email — forgot password, etc.)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@aprly.ai
# EMAIL_BUSINESS_NAME=APrly
# EMAIL_BUSINESS_ADDRESS=support@aprly.ai
# Optional override for email inline logo (default: artifacts/api-server/assets/email/logo.png).
# APRLY_EMAIL_LOGO_PATH=
# APRLY_EMAIL_COPY_ICON_PATH=
# ADMIN_OTP_TTL_SEC=600

# Stripe (Checkout uses price IDs; product IDs are optional / for your dashboard)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SANDBOX_SETUP_FEE_PRODUCT_ID=
STRIPE_SANDBOX_SETUP_FEE_PRICE_ID=
STRIPE_SANDBOX_SUBSCRIPTION_PRODUCT_ID=
STRIPE_SANDBOX_SUBSCRIPTION_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Local dev: run `stripe listen --forward-to http://127.0.0.1:${API_HOST_PORT:-5001}/api/stripe/webhook` and paste
# the **Ready** webhook signing secret (`whsec_...`) shown in that terminal. It changes when you
# restart `stripe listen` — update this value and restart `api-server` (or Docker) so
# `checkout.session.completed` verifies. Dashboard "Workbench → Webhooks" can stay empty when using CLI.
# Legacy (still read if sandbox price IDs above are unset):
# STRIPE_PRICE_ONE_TIME=
# STRIPE_PRICE_SUBSCRIPTION=

# OpenAI (optional for voice / AI features)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# Plaid (optional)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# Local sandbox (most institutions): leave PLAID_REDIRECT_URI unset — api-server skips redirect_uri on localhost.
# Local OAuth test (e.g. First Platypus Bank OAuth): register URI in Plaid Dashboard → Allowed redirect URIs:
# PLAID_REDIRECT_URI=http://localhost:5173/plaid/oauth
# Deployed dev/prod (auto when unset): {FRONTEND_ORIGIN}/plaid/oauth — or set explicitly:
# PLAID_REDIRECT_URI=https://dev.aprly.ai/plaid/oauth

# Frontend (Vite): leave VITE_API_URL unset in dev to use same-origin `/api` + vite proxy.
# In Docker Compose dev, `VITE_API_PROXY_TARGET` points the proxy at `api-server`.
# VITE_API_URL=http://127.0.0.1:5001
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Admin seed users (pnpm --filter @workspace/db run seed) — idempotent upsert by email
# Seeds: super.admin@aprly.ai, cliff@aprly.ai, maxim@aprly.ai (role=admin)
# ADMIN_SEED_PASSWORD=15975312
ADMIN_SEED_PASSWORD=

