# syntax=docker/dockerfile:1.7
#
# Helper image for one-shot ops on the production database:
#   - apply SQL migrations via `pnpm --filter @workspace/db run migrate`
#   - idempotent seed via `pnpm --filter @workspace/db run seed`
# Used in docker-compose.prod.yml as `db-migrate` and `db-seed` services.

FROM node:24-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# Avoid NODE_ENV=production before `pnpm install`: @workspace/db needs
# devDependencies (drizzle-kit, tsx) for migrate/seed scripts.

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/aprly/package.json ./artifacts/aprly/
COPY lib/db/package.json ./lib/db/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/integrations-openai-ai-server/package.json ./lib/integrations-openai-ai-server/
COPY lib/integrations-openai-ai-react/package.json ./lib/integrations-openai-ai-react/
COPY scripts/package.json ./scripts/

RUN corepack prepare pnpm@10.33.4 --activate

RUN node <<'NODE'
const fs = require("node:fs");
const p = "pnpm-workspace.yaml";
let y = fs.readFileSync(p, "utf8");
y = y.replace(/^minimumReleaseAge:\s*\d+/m, "minimumReleaseAge: 0");
fs.writeFileSync(p, y);
NODE

ENV npm_config_user_agent="pnpm/10.33.4 npm/? node/v24.0.0"

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

# Only the source we actually need at runtime — no api-server / frontend code.
COPY lib/db ./lib/db

CMD ["pnpm", "--filter", "@workspace/db", "run", "migrate"]
